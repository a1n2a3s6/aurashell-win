<Window x:Class="AuraShell.Views.StudioSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StudioTitle}"
        Width="780" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="#0B0E15"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        SourceInitialized="Window_SourceInitialized">

    <Border x:Name="RootChrome" BorderBrush="#2A3348" BorderThickness="1" CornerRadius="16" Background="#D80D111A">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top macOS-Style Header Bar (Draggable + Live AR/EN Switch + Close) -->
            <Border Grid.Row="0" BorderBrush="#1E2638" BorderThickness="0,0,0,1" Padding="18,0"
                    Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#0A84FF" Margin="0,0,10,0">
                            <TextBlock Text="✦" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle" Text="{DynamicResource StudioTitle}" FontSize="15.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="{DynamicResource StudioSubtitle}" FontSize="11" Foreground="#8E8E93"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Instant Live Arabic (RTL) / English (LTR) Header Switch -->
                        <Button x:Name="HeaderLangBtn" Style="{StaticResource IslandChipBtn}"
                                Click="HeaderLangBtn_Click" Padding="11,5" Margin="0,0,10,0" FontSize="11.5"/>
                        <Button Style="{StaticResource IslandIconBtn}" Content="✕" Width="30" Height="30"
                                Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Split: Sidebar Navigation + Content Pages -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="205"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border x:Name="SidebarChrome" Grid.Column="0" Background="#44080B12"
                        BorderBrush="#1E2638" BorderThickness="0,0,1,0" Padding="12,14">
                    <StackPanel>
                        <Button x:Name="NavBtn0" Style="{StaticResource IslandTabBtn}" HorizontalContentAlignment="Left"
                                Padding="12,9" Margin="0,0,0,5" Tag="0" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧭" Margin="0,0,9,0"/>
                                <TextBlock Text="{DynamicResource StudioNavOverview}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavBtn1" Style="{StaticResource IslandTabBtn}" HorizontalContentAlignment="Left"
                                Padding="12,9" Margin="0,0,0,5" Tag="1" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏝️" Margin="0,0,9,0"/>
                                <TextBlock Text="{DynamicResource StudioNavIsland}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavBtn2" Style="{StaticResource IslandTabBtn}" HorizontalContentAlignment="Left"
                                Padding="12,9" Margin="0,0,0,5" Tag="2" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🪟" Margin="0,0,9,0"/>
                                <TextBlock Text="{DynamicResource StudioNavWidgets}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavBtn3" Style="{StaticResource IslandTabBtn}" HorizontalContentAlignment="Left"
                                Padding="12,9" Margin="0,0,0,5" Tag="3" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀" Margin="0,0,9,0"/>
                                <TextBlock Text="{DynamicResource StudioNavDock}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavBtn4" Style="{StaticResource IslandTabBtn}" HorizontalContentAlignment="Left"
                                Padding="12,9" Margin="0,0,0,5" Tag="4" Click="NavBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,9,0"/>
                                <TextBlock Text="{DynamicResource StudioNavSystem}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right Content Area -->
                <Grid Grid.Column="1" Margin="22,16,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- PAGE 0: OVERVIEW -->
                            <StackPanel x:Name="PageOverview" Visibility="Visible">
                                <TextBlock Text="{DynamicResource StudioMasterModules}" FontSize="13.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,10"/>

                                <UniformGrid Columns="3" Margin="0,0,0,18">
                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="🏝️ AuraIsland" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <CheckBox x:Name="MasterIslandChk" Content="Enabled" Foreground="#38BDF8" Margin="0,10,0,0"
                                                      Checked="MasterToggle_Changed" Unchecked="MasterToggle_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="14" Padding="14" Margin="3,0">
                                        <StackPanel>
                                            <TextBlock Text="🪟 AuraWidgets" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <CheckBox x:Name="MasterWidgetsChk" Content="Enabled" Foreground="#34C759" Margin="0,10,0,0"
                                                      Checked="MasterToggle_Changed" Unchecked="MasterToggle_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="14" Padding="14" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🚀 AeroDock" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                            <CheckBox x:Name="MasterDockChk" Content="Enabled" Foreground="#BF5AF2" Margin="0,10,0,0"
                                                      Checked="MasterToggle_Changed" Unchecked="MasterToggle_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="{DynamicResource StudioThemePresets}" FontSize="13.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3">
                                    <Button x:Name="PresetSonomaBtn" Style="{StaticResource IslandTileBtn}" Click="PresetSonomaBtn_Click" Margin="0,0,6,0" Padding="12,14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🌑" FontSize="22" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource PresetSonomaDark}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PresetVisionBtn" Style="{StaticResource IslandTileBtn}" Click="PresetVisionBtn_Click" Margin="3,0" Padding="12,14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="❄️" FontSize="22" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource PresetVisionLight}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PresetObsidianBtn" Style="{StaticResource IslandTileBtn}" Click="PresetObsidianBtn_Click" Margin="6,0,0,0" Padding="12,14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🖤" FontSize="22" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource PresetObsidianPro}" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>

                            <!-- PAGE 1: AURAISLAND -->
                            <StackPanel x:Name="PageIsland" Visibility="Collapsed">
                                <CheckBox x:Name="IslandHideFsChk" Content="{DynamicResource StudioIslandHideFs}"
                                          Foreground="#E2E8F0" FontSize="12.5" Margin="0,0,0,12"/>

                                <TextBlock Text="{DynamicResource StudioIslandPillMode}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button x:Name="PillClockBtn" Style="{StaticResource IslandChipBtn}" Content="{DynamicResource PillModeClock}"
                                            Click="PillModeBtn_Click" Tag="Clock" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button x:Name="PillMediaBtn" Style="{StaticResource IslandChipBtn}" Content="{DynamicResource PillModeMedia}"
                                            Click="PillModeBtn_Click" Tag="Media" Padding="12,6" Margin="0,0,6,0"/>
                                    <Button x:Name="PillTelemetryBtn" Style="{StaticResource IslandChipBtn}" Content="{DynamicResource PillModeTelemetry}"
                                            Click="PillModeBtn_Click" Tag="Telemetry" Padding="12,6"/>
                                </StackPanel>

                                <TextBlock Text="{DynamicResource StudioAiProvider}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="ProvGeminiBtn" Style="{StaticResource IslandChipBtn}" Content="✨ Gemini 2.5 Flash"
                                            Click="ProvGeminiBtn_Click" Padding="12,6" Margin="0,0,8,0"/>
                                    <Button x:Name="ProvGroqBtn" Style="{StaticResource IslandChipBtn}" Content="⚡ Groq (Llama 3.3)"
                                            Click="ProvGroqBtn_Click" Padding="12,6" Margin="0,0,10,0"/>
                                    <Button x:Name="TestLatencyBtn" Style="{StaticResource IslandAccentBtn}" Content="{DynamicResource StudioTestLatency}"
                                            Click="TestLatencyBtn_Click" Padding="12,6"/>
                                </StackPanel>
                                <TextBlock x:Name="LatencyResultText" Text="" FontSize="11.5" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                <TextBlock Text="{DynamicResource StudioGeminiKey}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="GeminiKeyBox" Background="#141925" Foreground="#F8FAFC"
                                             BorderBrush="#263147" BorderThickness="1" Padding="8,6" Margin="0,0,0,10"/>

                                <TextBlock Text="{DynamicResource StudioGroqKey}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="GroqKeyBox" Background="#141925" Foreground="#F8FAFC"
                                             BorderBrush="#263147" BorderThickness="1" Padding="8,6" Margin="0,0,0,12"/>

                                <CheckBox x:Name="IslandCaffeineChk" Content="{DynamicResource StudioCaffeineHint}"
                                          Foreground="#E2E8F0" FontSize="12.5" Checked="IslandCaffeineChk_Changed" Unchecked="IslandCaffeineChk_Changed"/>
                            </StackPanel>

                            <!-- PAGE 2: AURAWIDGETS -->
                            <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource StudioWidgetGallery}" FontSize="13.5" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,10"/>

                                <UniformGrid Columns="3" Margin="0,0,0,14">
                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,6,6">
                                        <CheckBox x:Name="WidgetClockChk" Content="{DynamicResource WidgetClockTitle}" Foreground="#F8FAFC" Tag="clock" Checked="WidgetGalleryChk_Changed" Unchecked="WidgetGalleryChk_Changed"/>
                                    </Border>
                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="12" Padding="10" Margin="3,0,3,6">
                                        <CheckBox x:Name="WidgetMusicChk" Content="{DynamicResource WidgetMusicTitle}" Foreground="#F8FAFC" Tag="music" Checked="WidgetGalleryChk_Changed" Unchecked="WidgetGalleryChk_Changed"/>
                                    </Border>
                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="12" Padding="10" Margin="6,0,0,6">
                                        <CheckBox x:Name="WidgetRingsChk" Content="{DynamicResource WidgetRingsTitle}" Foreground="#F8FAFC" Tag="rings" Checked="WidgetGalleryChk_Changed" Unchecked="WidgetGalleryChk_Changed"/>
                                    </Border>
                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,6,0">
                                        <CheckBox x:Name="WidgetWeatherChk" Content="{DynamicResource WidgetWeatherTitle}" Foreground="#F8FAFC" Tag="weather" Checked="WidgetGalleryChk_Changed" Unchecked="WidgetGalleryChk_Changed"/>
                                    </Border>
                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="12" Padding="10" Margin="3,0">
                                        <CheckBox x:Name="WidgetCalendarChk" Content="{DynamicResource WidgetCalendarTitle}" Foreground="#F8FAFC" Tag="calendar" Checked="WidgetGalleryChk_Changed" Unchecked="WidgetGalleryChk_Changed"/>
                                    </Border>
                                    <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="12" Padding="10" Margin="6,0,0,0">
                                        <CheckBox x:Name="WidgetRemindersChk" Content="{DynamicResource WidgetRemindersTitle}" Foreground="#F8FAFC" Tag="reminders" Checked="WidgetGalleryChk_Changed" Unchecked="WidgetGalleryChk_Changed"/>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="{DynamicResource StudioWidgetTheme}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="ThemeDarkBtn" Style="{StaticResource IslandChipBtn}" Content="{DynamicResource WidgetThemeDark}" Click="ThemeDarkBtn_Click" Padding="11,6" Margin="0,0,6,0"/>
                                    <Button x:Name="ThemeLightBtn" Style="{StaticResource IslandChipBtn}" Content="{DynamicResource WidgetThemeLight}" Click="ThemeLightBtn_Click" Padding="11,6" Margin="0,0,6,0"/>
                                    <Button x:Name="ThemeAutoBtn" Style="{StaticResource IslandChipBtn}" Content="{DynamicResource WidgetThemeAuto}" Click="ThemeAutoBtn_Click" Padding="11,6"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource StudioWidgetOpacity}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="WidgetOpacityLabel" Text="92%" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                    <Slider x:Name="WidgetOpacitySlider" Grid.Row="1" Minimum="50" Maximum="100" Value="92" ValueChanged="WidgetOpacitySlider_ValueChanged"/>
                                </Grid>

                                <CheckBox x:Name="WidgetSnapChk" Content="{DynamicResource StudioWidgetSnap}" Foreground="#E2E8F0" FontSize="12.5" Margin="0,0,0,12"
                                          Checked="WidgetSnapChk_Changed" Unchecked="WidgetSnapChk_Changed"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource IslandChipBtn}" Content="{DynamicResource StudioLockAllWidgets}" Click="LockAllWidgetsBtn_Click" Padding="12,6" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource IslandChipBtn}" Content="{DynamicResource StudioUnlockAllWidgets}" Click="UnlockAllWidgetsBtn_Click" Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- PAGE 3: AERODOCK -->
                            <StackPanel x:Name="PageDock" Visibility="Collapsed">
                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource StudioDockIconSize}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DockSizeLabel" Text="44 px" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                    <Slider x:Name="DockSizeSlider" Grid.Row="1" Minimum="36" Maximum="56" Value="44" ValueChanged="DockSizeSlider_ValueChanged"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource StudioDockMag}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="DockMagLabel" Text="1.5x" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                    <Slider x:Name="DockMagSlider" Grid.Row="1" Minimum="1.0" Maximum="1.8" TickFrequency="0.1" Value="1.5" ValueChanged="DockMagSlider_ValueChanged"/>
                                </Grid>

                                <CheckBox x:Name="DockAutoHideChk" Content="{DynamicResource StudioDockAutoHide}" Foreground="#E2E8F0" FontSize="12.5" Margin="0,0,0,10"
                                          Checked="DockAutoHideChk_Changed" Unchecked="DockAutoHideChk_Changed"/>

                                <CheckBox x:Name="HideTaskbarChk" Content="{DynamicResource StudioHideTaskbar}" Foreground="#FBBF24" FontSize="12.5" Margin="0,0,0,16"
                                          Checked="HideTaskbarChk_Changed" Unchecked="HideTaskbarChk_Changed"/>

                                <Button Style="{StaticResource IslandChipBtn}" Content="{DynamicResource StudioResetDock}"
                                        Click="ResetDockBtn_Click" HorizontalAlignment="Left" Padding="14,7"/>
                            </StackPanel>

                            <!-- PAGE 4: SYSTEM & STARTUP -->
                            <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                                <CheckBox x:Name="LaunchWindowsChk" Content="{DynamicResource StudioLaunchWindows}"
                                          Foreground="#E2E8F0" FontSize="12.5" Margin="0,0,0,16"
                                          Checked="LaunchWindowsChk_Changed" Unchecked="LaunchWindowsChk_Changed"/>

                                <TextBlock Text="{DynamicResource StudioWeatherCity}" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                <TextBox x:Name="WeatherCityBox" Style="{StaticResource IslandTextBox}" Padding="9,6" Margin="0,0,0,16"/>

                                <Border Background="#161C2B" BorderBrush="#263147" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,18">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource StudioMemoryUsage}" FontSize="11.5" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="MemoryUsageText" Text="0 MB" FontSize="20" FontWeight="Bold" Foreground="#34C759" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource IslandChipBtn}" Content="{DynamicResource StudioTrimMemory}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6" Click="TrimMemoryBtn_Click"/>
                                    </Grid>
                                </Border>

                                <Button Style="{StaticResource IslandChipBtn}" Content="{DynamicResource TrayExit}"
                                        Foreground="#FF453A" BorderBrush="#FF453A" HorizontalAlignment="Left"
                                        Padding="16,8" Click="ExitAppBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Footer Bar -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="#34C759" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IslandChipBtn}" Content="{DynamicResource StudioClose}"
                                    Click="CloseBtn_Click" Padding="14,7" Margin="0,0,8,0"/>
                            <Button x:Name="SaveBtn" Style="{StaticResource IslandAccentBtn}" Content="{DynamicResource StudioSave}"
                                    Click="SaveBtn_Click" Padding="18,7"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
