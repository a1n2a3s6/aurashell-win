<Window x:Class="AuraShell.Modules.Dock.AeroDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AeroDock"
        Height="180" Width="1100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        SourceInitialized="Window_SourceInitialized"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        MouseMove="Window_MouseMove"
        MouseLeave="Window_MouseLeave">

    <Grid Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="AutoHideTransform" Y="0"/>
        </Grid.RenderTransform>

        <!-- Floating Dark Tooltip Pill Above Hovered Icon -->
        <Canvas x:Name="TooltipLayer" FlowDirection="LeftToRight" IsHitTestVisible="False">
            <Border x:Name="HoverTooltipPill"
                    Visibility="Collapsed"
                    Background="#E611131A"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,4">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <TextBlock x:Name="HoverTooltipText" Text="App" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
            </Border>
        </Canvas>

        <!-- Quick Downloads Stack Popup -->
        <Popup x:Name="DownloadsStackPopup" Placement="Top" PlacementTarget="{Binding ElementName=DockPill}"
               AllowsTransparency="True" StaysOpen="False" VerticalOffset="-8" HorizontalOffset="120">
            <Border Background="#E8151822" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="16" Padding="10" Width="260">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.55"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="{DynamicResource DockDownloads}" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Button Content="↗" Style="{StaticResource IslandChipBtn}" Padding="6,1" FontSize="11"
                                HorizontalAlignment="Right" Click="OpenDownloadsFolderBtn_Click"
                                ToolTip="{DynamicResource DockOpenDownloads}"/>
                    </Grid>
                    <StackPanel x:Name="DownloadsListPanel"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Floating Frosted-Glass AeroDock Pill (Exact CornerRadius="22") -->
        <Border x:Name="DockPill"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,12"
                CornerRadius="22"
                Background="#C8181A22"
                BorderThickness="1"
                Padding="12,8,12,6">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#48FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#18FFFFFF" Offset="0.4"/>
                    <GradientStop Color="#0DFFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.48"/>
            </Border.Effect>

            <StackPanel x:Name="DockItemsPanel" Orientation="Horizontal" VerticalAlignment="Bottom"/>
        </Border>
    </Grid>
</Window>
