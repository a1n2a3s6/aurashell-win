<Window x:Class="AuraShell.Modules.Island.EyedropperOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Canvas x:Name="OverlayCanvas" FlowDirection="LeftToRight">
        <!-- Floating live HEX color badge following the cursor -->
        <Border x:Name="SwatchBadge" Background="#E606070A" CornerRadius="10"
                BorderBrush="#38BDF8" BorderThickness="1.5" Padding="10,6"
                Canvas.Left="40" Canvas.Top="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ColorSwatch" Width="20" Height="20" CornerRadius="5"
                        Background="#38BDF8" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock x:Name="HexLabel" Text="#38BDF8" FontFamily="Consolas"
                               FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="{DynamicResource UtilEyedropperHint}" FontSize="10" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
