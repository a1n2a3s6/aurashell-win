<Window x:Class="AuraShell.Modules.Island.RegionScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#44000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Canvas x:Name="SelectionCanvas" FlowDirection="LeftToRight">
        <Border Background="#CC06070A" CornerRadius="10" Padding="12,6" Canvas.Left="24" Canvas.Top="24">
            <TextBlock Text="{DynamicResource UtilRegionHint}" Foreground="#F8FAFC" FontSize="12.5"/>
        </Border>
        <Rectangle x:Name="SelectionRect" Stroke="#38BDF8" StrokeThickness="2"
                   Fill="#2238BDF8" Visibility="Collapsed"/>
    </Canvas>
</Window>
