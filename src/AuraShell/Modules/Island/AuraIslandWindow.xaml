<Window x:Class="AuraShell.Modules.Island.AuraIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:AuraShell.Modules.Island.Tabs"
        Title="AuraIsland"
        Width="600" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        SourceInitialized="Window_SourceInitialized"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        MouseWheel="Window_MouseWheel">

    <Grid Background="Transparent">
        <!-- Main Pitch-Black #06070A Spring-Morphed Pill -->
        <Border x:Name="PillBorder"
                Width="244" Height="36"
                CornerRadius="18"
                Background="#06070A"
                BorderBrush="#1F2738"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                ClipToBounds="True"
                MouseEnter="PillBorder_MouseEnter"
                MouseLeave="PillBorder_MouseLeave"
                MouseLeftButtonDown="PillBorder_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.72"/>
            </Border.Effect>

            <Grid>
                <!-- COMPACT PILL VIEW -->
                <Grid x:Name="CompactView" Margin="10,0,12,0" VerticalAlignment="Center" Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mini Album Art / Aura Dot -->
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#141926"
                            ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Grid>
                            <Ellipse x:Name="CompactAuraDot" Width="8" Height="8" Fill="#38BDF8"/>
                            <Image x:Name="CompactAlbumArt" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Center: Live Clock or Active Timer or Toast -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="CompactTimerBadge" Text="" FontFamily="Consolas" FontSize="11.5"
                                   FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CompactPrimaryText" Text="10:24" FontFamily="Consolas" FontSize="12.5"
                                   FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                    </StackPanel>

                    <!-- Right: Mini 4-Bar Visualizer -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16" Margin="6,0,0,0">
                        <Rectangle x:Name="MiniBar0" Width="2.5" Height="5" RadiusX="1" RadiusY="1" Fill="#38BDF8" VerticalAlignment="Bottom" Margin="1,0"/>
                        <Rectangle x:Name="MiniBar1" Width="2.5" Height="10" RadiusX="1" RadiusY="1" Fill="#818CF8" VerticalAlignment="Bottom" Margin="1,0"/>
                        <Rectangle x:Name="MiniBar2" Width="2.5" Height="13" RadiusX="1" RadiusY="1" Fill="#C084FC" VerticalAlignment="Bottom" Margin="1,0"/>
                        <Rectangle x:Name="MiniBar3" Width="2.5" Height="7" RadiusX="1" RadiusY="1" Fill="#F472B6" VerticalAlignment="Bottom" Margin="1,0"/>
                    </StackPanel>
                </Grid>

                <!-- EXPANDED COMMAND HUB VIEW -->
                <Grid x:Name="ExpandedView" Opacity="0" Visibility="Collapsed" Margin="14,10,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: 5 Clickable/Swipeable Tabs + Live AR/EN Language Switch + Collapse -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TabBtn0" Style="{StaticResource IslandTabBtn}" Click="TabBtn_Click" Tag="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎵" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource TabMedia}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtn1" Style="{StaticResource IslandTabBtn}" Click="TabBtn_Click" Tag="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✨" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource TabAi}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtn2" Style="{StaticResource IslandTabBtn}" Click="TabBtn_Click" Tag="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📂" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource TabShelf}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtn3" Style="{StaticResource IslandTabBtn}" Click="TabBtn_Click" Tag="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱️" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource TabFocus}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabBtn4" Style="{StaticResource IslandTabBtn}" Click="TabBtn_Click" Tag="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠️" Margin="0,0,4,0"/>
                                    <TextBlock Text="{DynamicResource TabTools}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="QuickLangBtn" Style="{StaticResource IslandChipBtn}"
                                    Content="AR" Click="QuickLangBtn_Click" Padding="7,3" FontSize="10.5" Margin="0,0,5,0"
                                    ToolTip="{DynamicResource TraySwitchLang}"/>
                            <Button x:Name="PinExpandBtn" Style="{StaticResource IslandChipBtn}"
                                    Content="📌" Click="PinExpandBtn_Click" Padding="6,3" FontSize="10.5"
                                    ToolTip="Pin Expanded"/>
                        </StackPanel>
                    </Grid>

                    <!-- Active Tab Host -->
                    <Grid Grid.Row="2">
                        <tabs:MediaTabView x:Name="MediaTab" Visibility="Visible"/>
                        <tabs:AiCopilotTabView x:Name="AiTab" Visibility="Collapsed"/>
                        <tabs:FileShelfTabView x:Name="ShelfTab" Visibility="Collapsed"/>
                        <tabs:ProductivityTabView x:Name="ProdTab" Visibility="Collapsed"/>
                        <tabs:UtilitiesTabView x:Name="UtilTab" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Subtle Toast Notification Banner -->
                    <Border x:Name="ToastBanner" Grid.Row="3" Visibility="Collapsed"
                            Background="#152238" BorderBrush="#38BDF8" BorderThickness="1"
                            CornerRadius="8" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="ToastText" Text="" FontSize="11" Foreground="#E0F2FE" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
