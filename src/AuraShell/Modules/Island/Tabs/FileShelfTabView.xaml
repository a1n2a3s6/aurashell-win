<UserControl x:Class="AuraShell.Modules.Island.Tabs.FileShelfTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="4,2,4,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Feature 1-3 Drag-and-Drop File Shelf + Badge + Clear -->
        <Border Grid.Column="0" Background="#0E121B" CornerRadius="12" BorderBrush="#263147"
                BorderThickness="1" Padding="8" AllowDrop="True"
                DragOver="Shelf_DragOver" Drop="Shelf_Drop">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📂" Margin="0,0,5,0" FontSize="12"/>
                        <Border Background="#1E293B" CornerRadius="8" Padding="6,2">
                            <TextBlock x:Name="FileCountBadge" Text="0 files" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="ClearShelfBtn" Style="{StaticResource IslandChipBtn}"
                            Content="{DynamicResource ShelfClear}" Click="ClearShelfBtn_Click"
                            HorizontalAlignment="Right" Padding="7,2" FontSize="10.5"/>
                </Grid>

                <Grid Grid.Row="2">
                    <TextBlock x:Name="DropHintText"
                               Text="{DynamicResource ShelfDropHint}"
                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="6"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ShelfFilesPanel" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Column: Feature 4 Last 5 Clipboard History + Feature 5 Pin Note + Feature 6 Quick Scratchpad -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Last 5 Clipboard History -->
            <Border Grid.Row="0" Background="#0E121B" CornerRadius="10" BorderBrush="#1E2536"
                    BorderThickness="1" Padding="7,5">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ShelfClipboardTitle}" FontSize="10" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <WrapPanel x:Name="ClipboardPillsPanel" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource ShelfClipboardEmpty}" FontSize="10.5" Foreground="#64748B"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Feature 5: Pin Note -->
            <Grid Grid.Row="2">
                <TextBox x:Name="PinNoteBox" Style="{StaticResource IslandTextBox}"
                         FontSize="11" Padding="7,4"
                         ToolTip="{DynamicResource ShelfPinNote}"
                         TextChanged="PinNoteBox_TextChanged"/>
                <TextBlock x:Name="PinNotePlaceholder" Text="{DynamicResource ShelfPinNote}"
                           FontSize="11" Foreground="#64748B" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="9,0,0,0"/>
            </Grid>

            <!-- Feature 6: Quick Scratchpad -->
            <Grid Grid.Row="4">
                <TextBox x:Name="ScratchpadBox" Style="{StaticResource IslandTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" FontSize="11" Padding="7,5"
                         TextChanged="ScratchpadBox_TextChanged"/>
                <TextBlock x:Name="ScratchpadPlaceholder" Text="{DynamicResource ShelfScratchpad}"
                           FontSize="11" Foreground="#64748B" IsHitTestVisible="False"
                           VerticalAlignment="Top" Margin="9,6,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
