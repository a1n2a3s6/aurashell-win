<Window x:Class="AuraShell.Modules.Widgets.AppleWidgetHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="172" Height="172"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        SourceInitialized="Window_SourceInitialized"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Grid Background="Transparent">
        <!-- Main macOS Sonoma / iOS 18 Frosted Glass Shell (Exact CornerRadius="24") -->
        <Border x:Name="GlassSurface"
                CornerRadius="24"
                Background="#CC1C1C1E"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.34"/>
            </Border.Effect>

            <Grid>
                <!-- Widget Card Content -->
                <ContentPresenter x:Name="CardPresenter"/>

                <!-- Razor-Thin 1px Specular Top-Edge Glass Rim (Apple HIG) -->
                <Border x:Name="SpecularRim"
                        CornerRadius="24"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#44FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#18FFFFFF" Offset="0.22"/>
                            <GradientStop Color="#0DFFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <!-- Subtle Lock Badge when position is locked (appears faintly on hover) -->
                <Border x:Name="LockIndicator"
                        Visibility="Collapsed"
                        Background="#99000000"
                        CornerRadius="8"
                        Padding="5,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        IsHitTestVisible="False">
                    <TextBlock Text="🔒" FontSize="9" Foreground="#E5E5EA"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
