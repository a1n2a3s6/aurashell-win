<UserControl x:Class="AuraShell.Modules.Widgets.Cards.AppleClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="MediumRightCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Authentic Apple Analog Dial -->
        <Viewbox Grid.Column="0" Stretch="Uniform" MaxWidth="144" MaxHeight="144" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas x:Name="DialCanvas" FlowDirection="LeftToRight" Width="160" Height="160">
                <!-- Dial Face -->
                <Ellipse x:Name="DialFace" Width="154" Height="154" Canvas.Left="3" Canvas.Top="3" Fill="#14FFFFFF"/>

                <!-- Dynamic 60 Ticks + 12 Bold Numerals Layer -->
                <Canvas x:Name="TicksLayer" Width="160" Height="160"/>

                <!-- Compact Localized Date Pill inside dial (visible in Small mode) -->
                <Border x:Name="DialDatePill" Canvas.Left="46" Canvas.Top="100" Width="68" Height="18"
                        CornerRadius="9" Background="#22FFFFFF">
                    <TextBlock x:Name="DialDateText" Text="WED 25" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"/>
                </Border>

                <!-- Hour Hand -->
                <Rectangle x:Name="HourHand" Width="5" Height="42" RadiusX="2.5" RadiusY="2.5"
                           Fill="#FFFFFF" Canvas.Left="77.5" Canvas.Top="38">
                    <Rectangle.RenderTransform>
                        <RotateTransform x:Name="HourRotate" CenterX="2.5" CenterY="42"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- Minute Hand -->
                <Rectangle x:Name="MinuteHand" Width="3.5" Height="58" RadiusX="1.75" RadiusY="1.75"
                           Fill="#FFFFFF" Canvas.Left="78.25" Canvas.Top="22">
                    <Rectangle.RenderTransform>
                        <RotateTransform x:Name="MinuteRotate" CenterX="1.75" CenterY="58"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- Smooth Sweeping Apple Orange (#FF9F0A) Second Hand -->
                <Rectangle x:Name="SecondHand" Width="1.6" Height="72" RadiusX="0.8" RadiusY="0.8"
                           Fill="#FF9F0A" Canvas.Left="79.2" Canvas.Top="18">
                    <Rectangle.RenderTransform>
                        <RotateTransform x:Name="SecondRotate" CenterX="0.8" CenterY="62"/>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- Center Pin -->
                <Ellipse Width="8" Height="8" Fill="#FF9F0A" Canvas.Left="76" Canvas.Top="76"/>
                <Ellipse Width="3" Height="3" Fill="#1C1C1E" Canvas.Left="78.5" Canvas.Top="78.5"/>
            </Canvas>
        </Viewbox>

        <!-- Medium / Large Hybrid Digital Readout & Localized Date Pill -->
        <StackPanel x:Name="DigitalInfoPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,4,0" Visibility="Collapsed">
            <TextBlock x:Name="CityClockLabel" Text="{DynamicResource WidgetClockTitle}"
                       FontSize="12" FontWeight="SemiBold" Foreground="#FF9F0A" Margin="0,0,0,2"/>
            <TextBlock x:Name="DigitalTimeText" Text="10:34"
                       FontSize="42" FontWeight="Light" Foreground="#FFFFFF"
                       Typography.NumeralAlignment="Tabular" LineHeight="44"/>
            <Border x:Name="WideDatePill" Background="#22FFFFFF" CornerRadius="10" Padding="10,4"
                    HorizontalAlignment="Left" Margin="0,8,0,0">
                <TextBlock x:Name="WideDateText" Text="Wednesday, Nov 25" FontSize="12" FontWeight="Medium"
                           Foreground="#E5E5EA"/>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
