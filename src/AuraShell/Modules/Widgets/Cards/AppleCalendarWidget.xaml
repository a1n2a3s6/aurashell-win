<UserControl x:Class="AuraShell.Modules.Widgets.Cards.AppleCalendarWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="GridSpacerCol" Width="0"/>
            <ColumnDefinition x:Name="MonthGridCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Left / Small: Authentic macOS Red-Header Weekday + Huge Crisp Day Number -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="WeekdayText" Grid.Row="0" Text="WEDNESDAY"
                       FontSize="12" FontWeight="Bold" Foreground="#FF3B30"/>

            <TextBlock x:Name="DayNumberText" Grid.Row="1" Text="25"
                       FontSize="44" FontWeight="Light" Foreground="#FFFFFF"
                       Margin="-2,-6,0,0" Typography.NumeralAlignment="Tabular"/>

            <!-- Compact Mini Month Grid (shown below in Small/Large, or on right in Medium) -->
            <UniformGrid x:Name="SmallMonthGrid" Grid.Row="2" Columns="7" VerticalAlignment="Bottom" Margin="0,2,0,0"/>
        </Grid>

        <!-- Medium Wide Right Panel: Crisp Full Mini Month Calendar Grid -->
        <Grid x:Name="MediumMonthPanel" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MonthHeaderText" Grid.Row="0" Text="NOVEMBER 2026"
                       FontSize="11.5" FontWeight="Bold" Foreground="#FF3B30"/>

            <UniformGrid x:Name="WideMonthGrid" Grid.Row="2" Columns="7"/>
        </Grid>
    </Grid>
</UserControl>
