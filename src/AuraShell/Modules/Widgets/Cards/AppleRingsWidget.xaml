<UserControl x:Class="AuraShell.Modules.Widgets.Cards.AppleRingsWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Subtle Apple Header -->
        <TextBlock x:Name="HeaderTitle" Grid.Row="0" Text="{DynamicResource WidgetRingsTitle}"
                   FontSize="12" FontWeight="SemiBold" Foreground="#8E8E93"/>

        <!-- 4 Authentic Apple Activity Rings (CPU #0A84FF, RAM #34C759, Battery #FF9F0A, Disk #BF5AF2) -->
        <UniformGrid x:Name="RingsGrid" Grid.Row="2" Columns="4" Rows="1" VerticalAlignment="Center">
            <!-- Ring 1: CPU (#0A84FF) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3">
                <Grid Width="64" Height="64">
                    <Ellipse Stroke="#280A84FF" StrokeThickness="6"/>
                    <Path x:Name="CpuArc" Stroke="#0A84FF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="CpuPctText" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>
                <TextBlock Text="{DynamicResource UtilCpu}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Ring 2: RAM (#34C759) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3">
                <Grid Width="64" Height="64">
                    <Ellipse Stroke="#2834C759" StrokeThickness="6"/>
                    <Path x:Name="RamArc" Stroke="#34C759" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="RamPctText" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>
                <TextBlock Text="{DynamicResource UtilRam}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Ring 3: Battery (#FF9F0A) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3">
                <Grid Width="64" Height="64">
                    <Ellipse Stroke="#28FF9F0A" StrokeThickness="6"/>
                    <Path x:Name="BatArc" Stroke="#FF9F0A" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="BatPctText" Text="100%" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>
                <TextBlock Text="{DynamicResource UtilBattery}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Ring 4: Disk (#BF5AF2) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3">
                <Grid Width="64" Height="64">
                    <Ellipse Stroke="#28BF5AF2" StrokeThickness="6"/>
                    <Path x:Name="DiskArc" Stroke="#BF5AF2" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="DiskPctText" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>
                <TextBlock Text="{DynamicResource UtilDisk}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </UniformGrid>
    </Grid>
</UserControl>
